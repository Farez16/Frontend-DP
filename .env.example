# Sanity — proyecto "DP Agencia Deportiva" (ver Studio-DP/sanity.cli.ts)
# El dataset "production" tiene lectura pública: estos dos valores no son secretos,
# pero cada entorno declara los suyos explícitamente en .env.local (no versionado).
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Fecha de la API de Sanity a usar (formato YYYY-MM-DD). Opcional: si se omite,
# sanity/env.ts usa un valor por defecto.
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-21
