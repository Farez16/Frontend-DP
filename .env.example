# Sanity — proyecto "DP Agencia Deportiva" (ver Studio-DP/sanity.cli.ts)
# El dataset "production" tiene lectura pública: estos dos valores no son secretos,
# pero cada entorno declara los suyos explícitamente en .env.local (no versionado).
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Fecha de la API de Sanity a usar (formato YYYY-MM-DD). Opcional: si se omite,
# sanity/env.ts usa un valor por defecto.
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-21

# Resend — envío del formulario de contacto (app/api/contacto/route.ts).
# Las tres son obligatorias para que el formulario envíe; si falta alguna, la ruta
# responde un error controlado y la interfaz muestra su estado de error. Ninguna lleva
# el prefijo NEXT_PUBLIC_ a propósito: la API key es un secreto y las direcciones no
# tienen por qué viajar al navegador.

# Clave de API de Resend (https://resend.com/api-keys). Secreto: nunca se versiona.
RESEND_API_KEY=re_your_api_key

# Remitente. Mientras no haya un dominio verificado en Resend, el único remitente
# permitido es onboarding@resend.dev, y con él Resend SOLO entrega al correo de la
# cuenta propia o a las direcciones de prueba *@resend.dev; a cualquier otro
# destinatario devuelve 403. Para escribir a una dirección real hay que verificar
# somosdp.com en resend.com/domains y cambiar esto por algo@somosdp.com.
CONTACT_FROM_EMAIL=DP Agencia Deportiva <onboarding@resend.dev>

# Destinatario: el buzón del equipo que recibe los leads.
CONTACT_TO_EMAIL=destinatario@example.com
